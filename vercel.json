{
    "version": 2,
    "builds": [
      {
        "src": "package.json",
        "use": "@vercel/next"
      }
    ],
    "routes": [
      {
        "src": "/old-url",
        "dest": "/new-url",
        "status": 301
      },
      {
        "src": "/(.*)",
        "dest": "/$1",
        "status": 200
      }
    ]
  }